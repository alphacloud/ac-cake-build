<Project>
  <PropertyGroup Label="Build targets">
    <LibraryTargetFrameworks>net10.0;net11.0</LibraryTargetFrameworks>
  </PropertyGroup>

  <PropertyGroup Label="Build">
    <Product>Alphacloud.CakeBuild</Product>
    <Authors>Alphacloud</Authors>
    <Copyright>Copyright &#xA9; Alphacloud</Copyright>
    <TargetFrameworks>$(LibraryTargetFrameworks)</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DebugType>portable</DebugType>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
    <GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
    <GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
  </PropertyGroup>

  <!-- Generated by the SetVersion task; absent in plain IDE / pack-local builds. -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)Common/AssemblyVersion.cs')">
    <Compile Include="$(MSBuildThisFileDirectory)Common/AssemblyVersion.cs" Link="Properties/AssemblyVersion.cs" />
  </ItemGroup>

  <PropertyGroup Label="Package" Condition="'$(MSBuildProjectName.Contains(Tests))' == false">
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/alphacloud/ac-cake-build</PackageProjectUrl>
    <RepositoryUrl>https://github.com/alphacloud/ac-cake-build.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReleaseNotes>https://github.com/alphacloud/ac-cake-build/releases</PackageReleaseNotes>
    <PackageTags>cake;cake-build;frosting;build;appveyor;gitversion;nuget</PackageTags>
  </PropertyGroup>

  <PropertyGroup Label="SourceLink">
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName.Contains(Tests))' == true">
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
</Project>
